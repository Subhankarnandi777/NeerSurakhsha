{
  "expo": {
    "name": "NeerSurakhsha",
    "slug": "neersurakhsha",
    "scheme": "neersurakhsha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-location",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
